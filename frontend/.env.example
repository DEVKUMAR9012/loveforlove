# ── Frontend Environment Template ─────────────────────────────────────────
# Copy this file to .env.development / .env.production / .env.staging
# and fill in the values for your environment.
# NEVER put real secrets here — all VITE_ vars are public (bundled in JS).

# Backend API base URL (no trailing slash)
# dev:        http://localhost:4000
# production: https://your-app.onrender.com
VITE_API_URL=http://localhost:4000

# Human-readable label for the current environment
VITE_APP_ENV=development
