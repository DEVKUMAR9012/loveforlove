# ── Backend Environment Template ──────────────────────────────────────────
# Copy to .env and fill in your actual values.
# NEVER commit .env — it contains real secrets.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development        # development | staging | production

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/loveforlove

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_to_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=CHANGE_ME_to_a_different_long_random_string_min_64_chars

# ── Cloudinary ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# dev:        http://localhost:5173
# production: https://your-app.vercel.app
ALLOWED_ORIGIN=http://localhost:5173
