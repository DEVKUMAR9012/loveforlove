# ── Server ─────────────────────────────────────────────
PORT=4000

# ── MongoDB Atlas ───────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────
# Use a long random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret

# ── Cloudinary ──────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── CORS ────────────────────────────────────────────────
# Set this to your deployed frontend URL (no trailing slash)
# Comma-separate multiple origins if needed
# e.g. https://myapp.vercel.app
ALLOWED_ORIGIN=http://localhost:5173
