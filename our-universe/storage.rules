rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. User Avatars
    // Users can only upload and read their own files in their personal folder
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // 2. Couple Assets (Photos, Voice Notes)
    // Requires authentication to upload or view.
    // Note: To make this 100% airtight like Firestore, you would set Custom Claims 
    // on the user token containing their `coupleId`. For now, we restrict to authenticated users.
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
